    "Prediction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minimum": 1,
          "title": "Action Id",
          "type": "integer"
        },
        "channel": {
          "enum": [
            "voltage_v",
            "current_a",
            "temperature_c",
            "reference_w_m2"
          ],
          "title": "Channel",
          "type": "string"
        },
        "horizon_s": {
          "exclusiveMinimum": 0,
          "title": "Horizon S",
          "type": "number"
        },
        "interval_90": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval 90"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean"
        },
        "missingness_probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missingness Probability"
        },
        "query_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Query Id",
          "type": "string"
        },
        "sigma": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sigma"
        },
        "status": {
          "enum": [
            "predicted",
            "not_predictable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "query_id",
        "action_id",
        "channel",
        "horizon_s",
        "mean",
        "sigma",
        "status"
      ],
      "title": "Prediction",
      "type": "object"
    },
