{
  "$defs": {
    "ActionFeedback": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minimum": 1,
          "title": "Action Id",
          "type": "integer"
        },
        "code": {
          "enum": [
            "accepted",
            "executing",
            "completed",
            "rejected",
            "timed_out",
            "failed",
            "cancelled"
          ],
          "title": "Code",
          "type": "string"
        },
        "commanded_target": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "capture_rgb": "#/$defs/CaptureRGB",
                  "finish": "#/$defs/Finish",
                  "move_camera": "#/$defs/MoveCamera",
                  "probe_voltage": "#/$defs/ProbeVoltage",
                  "request_help": "#/$defs/RequestHelp",
                  "safe_stop": "#/$defs/SafeStop",
                  "set_voltage": "#/$defs/SetVoltage",
                  "wait": "#/$defs/Wait"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/MoveCamera"
                },
                {
                  "$ref": "#/$defs/SetVoltage"
                },
                {
                  "$ref": "#/$defs/ProbeVoltage"
                },
                {
                  "$ref": "#/$defs/CaptureRGB"
                },
                {
                  "$ref": "#/$defs/Wait"
                },
                {
                  "$ref": "#/$defs/RequestHelp"
                },
                {
                  "$ref": "#/$defs/SafeStop"
                },
                {
                  "$ref": "#/$defs/Finish"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Commanded Target"
        },
        "measured_confirmation": {
          "items": {
            "$ref": "#/$defs/MeasuredConfirmation"
          },
          "title": "Measured Confirmation",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "out_of_range",
                "budget",
                "busy",
                "sensor_unavailable",
                "tracking_timeout",
                "command_conflict",
                "invalid_payload"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "t_accepted_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "T Accepted S"
        },
        "t_terminal_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "T Terminal S"
        }
      },
      "required": [
        "action_id",
        "code",
        "reason",
        "t_accepted_s",
        "t_terminal_s",
        "commanded_target",
        "measured_confirmation"
      ],
      "title": "ActionFeedback",
      "type": "object"
    },
    "AxisSigma": {
      "additionalProperties": false,
