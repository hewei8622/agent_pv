        "help_requests",
        "decisions",
        "slide_path_m",
        "angular_path_rad"
      ],
      "title": "Budgets",
      "type": "object"
    },
    "CaptureRGB": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minimum": 1,
          "title": "Action Id",
          "type": "integer"
