{
  "$defs": {
    "CaptureRGB": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minimum": 1,
          "title": "Action Id",
          "type": "integer"
        },
        "kind": {
          "const": "capture_rgb",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "maximum": 15,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "timeout_s",
        "kind"
      ],
      "title": "CaptureRGB",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "discriminator": {
            "mapping": {
              "capture_rgb": "#/$defs/CaptureRGB",
              "finish": "#/$defs/Finish",
              "move_camera": "#/$defs/MoveCamera",
              "probe_voltage": "#/$defs/ProbeVoltage",
              "request_help": "#/$defs/RequestHelp",
              "safe_stop": "#/$defs/SafeStop",
              "set_voltage": "#/$defs/SetVoltage",
              "wait": "#/$defs/Wait"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/MoveCamera"
            },
            {
              "$ref": "#/$defs/SetVoltage"
            },
            {
              "$ref": "#/$defs/ProbeVoltage"
            },
            {
              "$ref": "#/$defs/CaptureRGB"
            },
            {
              "$ref": "#/$defs/Wait"
            },
            {
              "$ref": "#/$defs/RequestHelp"
            },
            {
              "$ref": "#/$defs/SafeStop"
            },
            {
              "$ref": "#/$defs/Finish"
            }
          ],
          "title": "Action"
        },
        "evidence_refs": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "hypothesis_probabilities": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/HypothesisProbability"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hypothesis Probabilities"
        },
        "predictions": {
          "items": {
            "$ref": "#/$defs/Prediction"
          },
          "title": "Predictions",
          "type": "array"
        },
        "rationale": {
          "maxLength": 1000,
          "title": "Rationale",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unresolved_hypotheses": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Unresolved Hypotheses",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "action",
        "predictions",
        "hypothesis_probabilities",
        "unresolved_hypotheses",
        "evidence_refs",
        "rationale"
      ],
      "title": "Decision",
      "type": "object"
    },
    "Finish": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minimum": 1,
          "title": "Action Id",
          "type": "integer"
        },
        "kind": {
          "const": "finish",
          "title": "Kind",
          "type": "string"
        },
        "resolution": {
          "enum": [
            "resolved",
            "unresolved",
            "help_needed"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "maximum": 15,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "timeout_s",
        "kind",
        "resolution"
      ],
      "title": "Finish",
      "type": "object"
    },
    "HypothesisProbability": {
      "additionalProperties": false,
      "properties": {
        "hypothesis": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Hypothesis",
          "type": "string"
        },
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        }
      },
      "required": [
        "hypothesis",
        "probability"
      ],
      "title": "HypothesisProbability",
      "type": "object"
    },
    "InformationChoice": {
      "additionalProperties": false,
      "properties": {
        "choice_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Choice Id",
          "type": "string"
        },
        "context_sequence_id": {
          "minimum": 0,
          "title": "Context Sequence Id",
          "type": "integer"
        },
        "information_refs": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 3,
          "title": "Information Refs",
          "type": "array"
        },
        "kind": {
          "const": "information",
          "default": "information",
          "title": "Kind",
          "type": "string"
        },
        "observation_refs": {
          "default": [],
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Observation Refs",
          "type": "array"
        },
        "request": {
          "$ref": "#/$defs/InteractionRequest"
        },
        "schema_version": {
          "const": "investigation/1.0",
          "default": "investigation/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "self_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelfModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "world_belief": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorldBelief"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "choice_id",
        "context_sequence_id",
        "request"
      ],
      "title": "InformationChoice",
      "type": "object"
    },
    "InteractionRequest": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "human",
            "internet"
          ],
          "title": "Channel",
          "type": "string"
        },
        "episode_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Episode Id",
          "type": "string"
        },
        "information_gap": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Information Gap",
          "type": "string"
        },
        "intended_decision": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Intended Decision",
          "type": "string"
        },
        "parent_request_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Request Id"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "interaction/1.0",
          "default": "interaction/1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "episode_id",
        "request_id",
        "channel",
        "question",
        "information_gap",
        "intended_decision"
      ],
      "title": "InteractionRequest",
      "type": "object"
    },
    "MoveCamera": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minimum": 1,
          "title": "Action Id",
          "type": "integer"
        },
        "capture_after_settle": {
          "title": "Capture After Settle",
          "type": "boolean"
        },
        "kind": {
          "const": "move_camera",
          "title": "Kind",
          "type": "string"
        },
        "pitch_rad": {
          "maximum": 0.5235987755982988,
          "minimum": -0.5235987755982988,
          "title": "Pitch Rad",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "slide_m": {
          "maximum": 0.15,
          "minimum": -0.15,
          "title": "Slide M",
          "type": "number"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "maximum": 15,
          "title": "Timeout S",
          "type": "number"
        },
        "yaw_rad": {
          "maximum": 0.7853981633974483,
          "minimum": -0.7853981633974483,
          "title": "Yaw Rad",
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "timeout_s",
        "kind",
        "slide_m",
        "yaw_rad",
        "pitch_rad",
        "capture_after_settle"
      ],
      "title": "MoveCamera",
      "type": "object"
    },
