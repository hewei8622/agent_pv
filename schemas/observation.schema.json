          "type": "number"
        },
        "t_deliver_s": {
          "minimum": 0,
          "title": "T Deliver S",
          "type": "number"
        },
        "validity": {
          "enum": [
            "valid",
            "missing",
            "saturated",
            "stale"
          ],
          "title": "Validity",
          "type": "string"
