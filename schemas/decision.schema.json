{
  "$defs": {
    "CaptureRGB": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minimum": 1,
          "title": "Action Id",
          "type": "integer"
        },
        "kind": {
          "const": "capture_rgb",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "maximum": 15,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "timeout_s",
        "kind"
      ],
      "title": "CaptureRGB",
      "type": "object"
    },
    "Finish": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minimum": 1,
          "title": "Action Id",
          "type": "integer"
        },
        "kind": {
          "const": "finish",
          "title": "Kind",
          "type": "string"
        },
        "resolution": {
          "enum": [
            "resolved",
            "unresolved",
            "help_needed"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "maximum": 15,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "timeout_s",
        "kind",
        "resolution"
      ],
      "title": "Finish",
      "type": "object"
    },
    "HypothesisProbability": {
      "additionalProperties": false,
      "properties": {
        "hypothesis": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Hypothesis",
          "type": "string"
        },
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        }
      },
      "required": [
        "hypothesis",
        "probability"
      ],
      "title": "HypothesisProbability",
      "type": "object"
    },
    "MoveCamera": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minimum": 1,
          "title": "Action Id",
          "type": "integer"
        },
        "capture_after_settle": {
          "title": "Capture After Settle",
          "type": "boolean"
        },
        "kind": {
          "const": "move_camera",
          "title": "Kind",
          "type": "string"
        },
        "pitch_rad": {
          "maximum": 0.5235987755982988,
          "minimum": -0.5235987755982988,
          "title": "Pitch Rad",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "slide_m": {
          "maximum": 0.15,
          "minimum": -0.15,
          "title": "Slide M",
          "type": "number"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "maximum": 15,
          "title": "Timeout S",
          "type": "number"
        },
        "yaw_rad": {
          "maximum": 0.7853981633974483,
          "minimum": -0.7853981633974483,
          "title": "Yaw Rad",
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "timeout_s",
        "kind",
        "slide_m",
        "yaw_rad",
        "pitch_rad",
        "capture_after_settle"
      ],
      "title": "MoveCamera",
      "type": "object"
    },
    "Prediction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minimum": 1,
          "title": "Action Id",
          "type": "integer"
        },
        "channel": {
          "enum": [
            "voltage_v",
            "current_a",
            "temperature_c",
            "reference_w_m2"
          ],
          "title": "Channel",
          "type": "string"
        },
        "horizon_s": {
          "exclusiveMinimum": 0,
          "title": "Horizon S",
          "type": "number"
        },
        "interval_90": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval 90"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean"
        },
        "missingness_probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missingness Probability"
        },
        "query_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Query Id",
          "type": "string"
        },
        "sigma": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sigma"
        },
        "status": {
          "enum": [
            "predicted",
            "not_predictable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "query_id",
        "action_id",
        "channel",
        "horizon_s",
        "mean",
        "sigma",
        "status"
      ],
      "title": "Prediction",
      "type": "object"
    },
    "ProbeVoltage": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minimum": 1,
          "title": "Action Id",
          "type": "integer"
        },
        "dwell_s": {
          "maximum": 2.0,
          "minimum": 0.2,
          "title": "Dwell S",
          "type": "number"
        },
        "kind": {
          "const": "probe_voltage",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "maximum": 15,
          "title": "Timeout S",
          "type": "number"
        },
        "voltages_v": {
          "items": {
            "maximum": 4.0,
            "minimum": 0.2,
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Voltages V",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "timeout_s",
        "kind",
        "voltages_v",
        "dwell_s"
      ],
      "title": "ProbeVoltage",
      "type": "object"
    },
    "RequestHelp": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minimum": 1,
          "title": "Action Id",
          "type": "integer"
        },
        "kind": {
          "const": "request_help",
          "title": "Kind",
          "type": "string"
        },
        "measurement": {
          "enum": [
            "reference_irradiance",
            "rear_inspection"
          ],
          "title": "Measurement",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "maximum": 15,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "timeout_s",
        "kind",
        "measurement"
      ],
      "title": "RequestHelp",
      "type": "object"
    },
    "SafeStop": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minimum": 1,
          "title": "Action Id",
          "type": "integer"
        },
        "kind": {
          "const": "safe_stop",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "maximum": 15,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "timeout_s",
        "kind"
      ],
      "title": "SafeStop",
      "type": "object"
    },
    "SetVoltage": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minimum": 1,
          "title": "Action Id",
          "type": "integer"
        },
        "kind": {
          "const": "set_voltage",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "maximum": 15,
          "title": "Timeout S",
          "type": "number"
        },
        "voltage_v": {
          "maximum": 4.0,
          "minimum": 0.2,
          "title": "Voltage V",
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "timeout_s",
        "kind",
        "voltage_v"
      ],
      "title": "SetVoltage",
      "type": "object"
    },
    "Wait": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minimum": 1,
          "title": "Action Id",
          "type": "integer"
        },
        "duration_s": {
          "maximum": 5,
          "minimum": 0.1,
          "title": "Duration S",
          "type": "number"
        },
        "kind": {
          "const": "wait",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "maximum": 15,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "timeout_s",
        "kind",
        "duration_s"
      ],
      "title": "Wait",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "discriminator": {
        "mapping": {
          "capture_rgb": "#/$defs/CaptureRGB",
          "finish": "#/$defs/Finish",
          "move_camera": "#/$defs/MoveCamera",
          "probe_voltage": "#/$defs/ProbeVoltage",
          "request_help": "#/$defs/RequestHelp",
          "safe_stop": "#/$defs/SafeStop",
          "set_voltage": "#/$defs/SetVoltage",
          "wait": "#/$defs/Wait"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MoveCamera"
        },
        {
          "$ref": "#/$defs/SetVoltage"
        },
        {
          "$ref": "#/$defs/ProbeVoltage"
        },
        {
          "$ref": "#/$defs/CaptureRGB"
        },
        {
          "$ref": "#/$defs/Wait"
        },
        {
          "$ref": "#/$defs/RequestHelp"
        },
        {
          "$ref": "#/$defs/SafeStop"
        },
        {
          "$ref": "#/$defs/Finish"
        }
      ],
      "title": "Action"
    },
    "evidence_refs": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "hypothesis_probabilities": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/HypothesisProbability"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Hypothesis Probabilities"
    },
    "predictions": {
      "items": {
        "$ref": "#/$defs/Prediction"
      },
      "title": "Predictions",
      "type": "array"
    },
    "rationale": {
      "maxLength": 1000,
      "title": "Rationale",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unresolved_hypotheses": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "title": "Unresolved Hypotheses",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "action",
    "predictions",
    "hypothesis_probabilities",
    "unresolved_hypotheses",
    "evidence_refs",
    "rationale"
  ],
  "title": "Decision",
  "type": "object"
}
